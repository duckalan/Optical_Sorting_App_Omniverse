[package]
title = "Optical Cap Sorting Zero Delay"
version = "0.1.0"
description = "Zero Delay configuration of Optical Cap Sorting"
keywords = ["experience", "app", "dev", "zero_delay"]
template_name = "isaacsim.exp.template.zero_delay"

[dependencies]
"kvantron.optical_cap_sorting" = {}  # Application Kit File

[settings]
app.hydraEngine.waitIdle = true
app.updateOrder.checkForHydraRenderComplete = 1000
app.vulkan = true # Explicitly enable Vulkan (on by default on Linux, off by default on Windows)
app.enableDeveloperWarnings = false # disable developer warnings to reduce log noise
app.exts.isaacsim.ros2.bridge.publish_multithreading_disabled = true # disable multithreading for ros2 bridge to reduce latency

[settings.app.exts.folders]
'++' = [
    "${app}",
    "${app}/../exts",
    "${app}/../extscache",
]
[template]
type = "ApplicationLayerTemplate" # Repo Template Metadata

