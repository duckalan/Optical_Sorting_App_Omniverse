{
    "CheckOvality": {
        "version": 1,
        "uiName": "Check Ovality",
        "icon": "icons/icon.svg",
        "description": "Description",
        "categoryDefinitions": "config/CategoryDefinition.json",
        "categories": "kvantron",
        "language": "c++",
        "inputs": {
            "execIn": {
                "type": "execution",
                "uiName": "ExecIn",
                "description": "Signal to check."
            },
            "tick": {
                "type": "execution",
                "uiName": "Tick",
                "description": "TODO."
            },
            "imageData": {
                "type": "uchar[]",
                "uiName": "Image data",
                "description": "Must be in RGBA8 only by now."
            },
            "imageWidth": {
                "type": "uint",
                "uiName": "Image Width",
                "description": "The width of passed image."
            },
            "imageHeight": {
                "type": "uint",
                "uiName": "Image Height",
                "description": "The height of passed image."
            },
            "imageFormat": {
                "type": "uint",
                "uiName": "Image Format",
                "description": "The format (omni.ui.TextureFormat) of the input image."
            },
            "ovalityThreshold": {
                "type": "double",
                "uiName": "Ovality Threshold",
                "description": "The ovality threshold value used for checking ovality.",
                "default": 0.9
            }
        },
        "outputs": {
            "execOut": {
                "type": "execution",
                "uiName": "ExecOut",
                "description": "Sends a signal to continue the downstream after the image processing."
            },
            "defectDetected": {
                "type": "execution",
                "uiName": "Defect Detected",
                "description": "Sends a signal to continue the downstream if the ovality of the input image is lower than the Ovality Threshold value."
            },
            "tick": {
                "type": "execution",
                "uiName": "Tick",
                "description": "TODO."
            },
            "processedImage": {
                "type": "uchar[]",
                "uiName": "Processed Image",
                "description": "The image after processing."
            },
            "imageWidth": {
                "type": "uint",
                "uiName": "Image Width",
                "description": "The width of the processed image."
            },
            "imageHeight": {
                "type": "uint",
                "uiName": "Image Height",
                "description": "The height of the processed image."
            },
            "imageFormat": {
                "type": "uint",
                "uiName": "Image Format",
                "description": "The format (omni.ui.TextureFormat) of the processed image."
            }
        }
    }
}
