{
    "SpawnBottleCap": {
        "version": 1,
        "language": "python",
        "icon": "icons/icon.svg",
        "uiName": "Spawn Polypropelene Bottle Cap",
        "description": "Description",
        "categoryDefinitions": "config/CategoryDefinition.json",
        "categories": "kvantron",
        "scheduling": ["usd-write"],
        "inputs": {
            "execIn": {
                "type": "execution",
                "uiName": "ExecIn",
                "description": "Tick"
            },
            "spawnOrigin": {
                "type": "pointd[3]",
                "uiName": "Spawn Origin",
                "description": "Description for this attribute"
            },
            "distanceBetweenPairCaps": {
                "type": "float",
                "uiName": "Distance Between Pair Caps",
                "description": "Description for this attribute",
                "default": 115.0
            },
            "capAliveTime": {
                "type": "float",
                "uiName": "Cap Alive Time",
                "description": "Description for this attribute",
                "default": 10.0
            },
            "capPaintColor": {
                "type": "token",
                "uiName": "Cap Paint Color",
                "description": "Description for this attribute",
                "metadata": {
                    "allowedTokens": ["Blue", "Dark_Orange", "Dark_Green"]
                },
                "default": "Blue"
            },
            "capAssetPath": {
                "type": "string",
                "uiName": "Cap Asset Path",
                "description": "Description for this attribute",
                "metadata": {
                    "uiType": "filePath"
                }
            },
            "capInstancePathTemplate": {
                "type": "string",
                "uiName": "Cap Instance Path Template",
                "description": "Template + current cap number",
                "default": "PolypropeleneBottleCap_"
            }
        },
        "outputs": {
        }
    }
}
